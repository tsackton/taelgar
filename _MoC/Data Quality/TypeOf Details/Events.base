views:
  - type: table
    name: Table
    filters:
      and:
        - file.tags.contains("event")
        - '!file.folder.startsWith("Worldbuilding")'
        - '!file.tags.contains("status/stub")'
    order:
      - file.name
      - typeOf
      - subtypeOf
      - typeOfAlias
      - ancestry
      - partOf
      - DR
      - DR_end
    sort:
      - property: DR
        direction: ASC
      - property: DR_end
        direction: ASC
      - property: partOf
        direction: ASC
      - property: typeOf
        direction: ASC
      - property: subtypeOf
        direction: DESC
      - property: campaignInfo
        direction: ASC
      - property: pronunciation
        direction: ASC
      - property: population
        direction: ASC
    columnSize:
      note.typeOf: 144
      note.partOf: 173
      note.DR_end: 146
